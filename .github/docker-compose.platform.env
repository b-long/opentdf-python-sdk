# Single source of truth for the opentdf/platform version pinned in
# docker-compose.platform.override.yaml. Passed to `docker compose` via
# --env-file so PLATFORM_VERSION only has to be declared once.
#
# v0.15.0 is the newest platform release whose opentdf-example.yaml does not
# reference hybrid post-quantum KAS keys. Newer releases need
# generate-pqc-keys (see docker-compose.platform.override.yaml) to actually
# run, so the remaining bump is tracked separately -- see issue #182.
PLATFORM_VERSION=v0.15.0
